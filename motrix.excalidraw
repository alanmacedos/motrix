      "text": "Motrix/\n│\n├── frontend/\n│   │\n│   ├── index.html\n│   │\n│   ├── css/\n│   │   ├── global.css\n│   │   └── index.css\n│   │\n│   ├── js/\n│   │   └── index.js\n│   │\n│   └── images/\n│       └── motrix.png\n│\n└── esp32/\n    │\n    ├── motrix.ino\n    │\n    ├── wifi/\n    │   └── wifiManager\n    │\n    ├── communication/\n    │   ├── websocket\n    │   └── protocol\n    │\n    ├── control/\n    │   ├── steering\n    │   ├── throttle\n    │   └── traction\n    │\n    └── safety/\n        └── failSafe",
      "fontSize": 71.4294765240452,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Motrix/\n│\n├── frontend/\n│   │\n│   ├── index.html\n│   │\n│   ├── css/\n│   │   ├── global.css\n│   │   └── index.css\n│   │\n│   ├── js/\n│   │   └── index.js\n│   │\n│   └── images/\n│       └── motrix.png\n│\n└── esp32/\n    │\n    ├── motrix.ino\n    │\n    ├── wifi/\n    │   └── wifiManager\n    │\n    ├── communication/\n    │   ├── websocket\n    │   └── protocol\n    │\n    ├── control/\n    │   ├── steering\n    │   ├── throttle\n    │   └── traction\n    │\n    └── safety/\n        └── failSafe",
      "autoResize": false,
